{
  "name": "opd-flow",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "observability:up": "docker compose -f docker-compose.observability.yml up -d",
    "observability:down": "docker compose -f docker-compose.observability.yml down",
    "load:test": "k6 run load-tests/appointments.js",
    "format": "prettier --write \"src/**/*.js\" \"server/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"server/**/*.js\" \"*.js\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "mongoose": "^8.9.3",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "vite": "^6.0.5"
  }
}
