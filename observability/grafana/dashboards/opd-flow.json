{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(opd_http_requests_total[5m]))", "legendFormat": "requests / second", "refId": "A" }],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "sum(rate(opd_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(opd_http_requests_total[5m]))", "legendFormat": "5xx error rate", "refId": "A" }],
      "title": "Server error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(opd_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "p95 request latency by route",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["opd", "prometheus"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "OPD Flow API",
  "uid": "opd-flow-api",
  "version": 1
